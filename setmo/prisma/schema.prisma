// SetMo — Prisma schema
// Source of truth: design_handoff_setmo/DATA_MODEL.md (UI-aligned) +
// SetMo_Technical_Spec.md §4 (partner/channel tables). Postgres on Supabase.
// Score integrity rule: official scores + session durations are written
// server-side only (from the ElevenLabs post-call webhook), never the browser.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Role {
  PLATFORM_ADMIN // internal Super Admin — everything incl. config + managing admins
  SUPPORT // internal Success/Support — everything except config + managing admins
  DISTRIBUTOR
  CONSULTANT
  GROUP_ADMIN
  OFFICE_ADMIN
  SETTER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OrganizationType {
  GROUP
  INDEPENDENT
}

enum PartnerType {
  DISTRIBUTOR
  INDEPENDENT_CONSULTANT
}

enum PartnerStatus {
  PENDING
  APPROVED
  DISABLED
}

enum ServiceKey {
  IMPLANT
  DENTURE
  COSMETIC
  ORTHO
  WISDOM
  GENERAL
}

enum AgentStatus {
  LIVE
  DRAFT
  PLANNED
}

enum SessionStatus {
  CREATED
  IN_PROGRESS
  SCORED
  COMPLETED
  FAILED
}

enum SessionKind {
  PRACTICE
  COACH
}

enum Difficulty {
  ADAPTIVE
  WARM
  TOUGH
}

enum SkillTier {
  UNIVERSAL
  SERVICE_SPECIFIC
}

enum TrainingType {
  VIDEO
  WORKBOOK
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
}

enum RecommendationStatus {
  ACTIVE
  DISMISSED
  COMPLETED
}

enum Cadence {
  MONTHLY // legacy — plans are now quarterly or annual only
  QUARTERLY
  ANNUAL
}

enum PlanTier {
  TEAM // per setter seat
  PRACTICE // per location (1 manager + 2 setters) + extra setters
  GROUP // custom / sales-led
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum LeaderboardScope {
  OFFICE
  GLOBAL
}

enum SubjectType {
  SETTER
  OFFICE
  GROUP
}

enum LeaderboardMetric {
  AVG_SCORE
  IMPROVEMENT
}

// ---------- tenancy ----------

model Organization {
  id        String           @id @default(uuid())
  name      String
  type      OrganizationType @default(GROUP)
  createdAt DateTime         @default(now())

  offices Office[]
  users   User[]
  goals   Goal[]

  @@map("organization")
}

model Office {
  id               String   @id @default(uuid())
  organizationId   String?  @map("organization_id")
  name             String
  city             String?
  offerFraming     String?  @map("offer_framing")
  appointmentFraming String? @map("appointment_framing")
  depositPolicy    String?  @map("deposit_policy")
  seatCount        Int      @default(1) @map("seat_count")
  stripeCustomerId String?  @map("stripe_customer_id")
  isProspect       Boolean  @default(false) @map("is_prospect") // created by a pre-sale Setter Audit, not yet a customer
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization?       @relation(fields: [organizationId], references: [id])
  users        User[]
  services     OfficeService[]
  sessions     Session[]
  bundles      ConversationBundle[]
  subscription Subscription?
  outcomes     OfficeOutcome[]
  audits       SetterAudit[]
  goals        Goal[]

  @@index([organizationId])
  @@map("office")
}

// Real-world results the practice reports (client feedback). Collected now so
// training→outcome reporting becomes possible once there's history. One row per
// office per period (month).
model OfficeOutcome {
  id             String   @id @default(uuid())
  officeId       String   @map("office_id")
  periodLabel    String   @map("period_label") // "2026-06"
  monthlyLeads   Int?     @map("monthly_leads") // new high-value leads this month (grounds the projection)
  consultsBooked Int?     @map("consults_booked")
  casesStarted   Int?     @map("cases_started")
  production     Int? // whole dollars
  note           String? // manager's qualitative feedback for the period
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, periodLabel])
  @@index([officeId])
  @@map("office_outcome")
}

model User {
  id             String     @id // = Supabase auth user id
  officeId       String?    @map("office_id")
  organizationId String?    @map("organization_id")
  partnerId      String?    @map("partner_id")
  role           Role
  firstName      String?    @map("first_name")
  lastName       String?    @map("last_name")
  email          String     @unique
  status         UserStatus @default(INVITED)
  invitedById    String?    @map("invited_by")
  createdAt      DateTime   @default(now()) @map("created_at")

  office       Office?       @relation(fields: [officeId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  partner      Partner?      @relation(fields: [partnerId], references: [id])
  invitedBy    User?         @relation("Invites", fields: [invitedById], references: [id])
  invitees     User[]        @relation("Invites")

  sessions        Session[]
  memory          SetterMemory?
  recommendations Recommendation[]
  managedAccounts ManagedAccount[] @relation("ConsultantManaged")
  memberships     Membership[]
  goalParticipations GoalParticipant[]

  @@index([officeId])
  @@index([organizationId])
  @@index([partnerId])
  @@map("user")
}

enum MembershipScope {
  OFFICE
  GROUP
  PLATFORM
}

// Roles a user holds. A user may hold several (e.g. a manager who also takes
// calls) and switches the ACTIVE one; nav/data/actions follow the active role.
// `User.role` remains the user's primary/default role.
model Membership {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  role      Role
  scopeType MembershipScope  @default(OFFICE) @map("scope_type")
  scopeId   String?          @map("scope_id") // officeId / organizationId; null for PLATFORM
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeId])
  @@index([userId])
  @@map("membership")
}

// ---------- channel partners (v1 schema; self-serve portal is later) ----------

model Partner {
  id              String        @id @default(uuid())
  name            String
  type            PartnerType
  status          PartnerStatus @default(PENDING)
  commissionEnabled Boolean     @default(false) @map("commission_enabled")
  commissionTerms Json?         @map("commission_terms")
  createdAt       DateTime      @default(now()) @map("created_at")

  users           User[]
  managedAccounts ManagedAccount[]

  @@map("partner")
}

model ManagedAccount {
  id               String  @id @default(uuid())
  partnerId        String  @map("partner_id")
  consultantUserId String? @map("consultant_user_id")
  officeId         String? @map("office_id")
  organizationId   String? @map("organization_id")

  partner    Partner @relation(fields: [partnerId], references: [id])
  consultant User?   @relation("ConsultantManaged", fields: [consultantUserId], references: [id])

  @@index([partnerId])
  @@map("managed_account")
}

// ---------- service catalog / agents ----------

model Agent {
  id                String      @id @default(uuid())
  serviceType       ServiceKey  @unique @map("service_type")
  name              String
  shortName         String?     @map("short_name")
  status            AgentStatus @default(PLANNED)
  version           String?
  elevenlabsAgentId String?     @map("elevenlabs_agent_id")
  rubricSkills      Json        @map("rubric_skills") // ordered skill keys for this service
  personaCount      Int         @default(0) @map("persona_count")
  note              String?

  sessions Session[]

  @@map("agent")
}

model OfficeService {
  officeId    String     @map("office_id")
  serviceType ServiceKey @map("service_type")
  enabled     Boolean    @default(true)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@id([officeId, serviceType])
  @@map("office_service")
}

// ---------- sessions, evaluations, scoring ----------

model Session {
  id                     String        @id @default(uuid())
  setterId               String        @map("setter_id")
  officeId               String        @map("office_id") // denormalized for scoping/leaderboards
  serviceType            ServiceKey    @map("service_type")
  kind                   SessionKind   @default(PRACTICE) // PRACTICE (scored) | COACH (voice coaching, metered only)
  agentId                String?       @map("agent_id")
  personaSeed            Json?         @map("persona_seed") // difficulty + hidden "why" (never shown pre-call)
  difficulty             Difficulty    @default(ADAPTIVE)
  elevenlabsConversationId String?     @unique @map("elevenlabs_conversation_id")
  transcriptRef          String?       @map("transcript_ref")
  audioPath              String?       @map("audio_path") // Supabase Storage path to the call recording
  startedAt              DateTime      @default(now()) @map("started_at")
  completedAt            DateTime?     @map("completed_at")
  durationSeconds        Int?          @map("duration_seconds") // authoritative, from webhook
  status                 SessionStatus @default(CREATED)
  saved                  Boolean       @default(false) // setter/admin flagged this recording to keep
  savedAt                DateTime?     @map("saved_at")
  shareToken             String?       @unique @map("share_token") // set when a read-only share link is generated
  sharedAt               DateTime?     @map("shared_at")
  isAudit                Boolean       @default(false) @map("is_audit") // part of a pre-sale Setter Audit
  auditId                String?       @map("audit_id")

  setter     User         @relation(fields: [setterId], references: [id])
  office     Office       @relation(fields: [officeId], references: [id])
  agent      Agent?       @relation(fields: [agentId], references: [id])
  evaluation Evaluation?
  audit      SetterAudit? @relation(fields: [auditId], references: [id])

  @@index([setterId])
  @@index([officeId])
  @@index([serviceType])
  @@index([auditId])
  @@map("session")
}

enum SetterAuditStatus {
  CREATED // intake done, email not yet verified
  PENDING_APPROVAL // free-email or duplicate domain — awaiting platform-admin approval
  ACTIVE // verified + approved, running the 5 calls
  SCORED // all 5 scored, report ready
}

// The pre-sale Setter Audit: a prospect runs 5 calls, we score them and produce
// a one-page report. One free per practice (by email domain). Light login via a
// per-audit token (no Supabase account). Calls are owned by a prospect User in a
// prospect Office.
model SetterAudit {
  id           String            @id @default(uuid())
  officeId     String            @map("office_id") // prospect (or claimed) office
  prospectUserId String          @map("prospect_user_id") // owns the audit's sessions
  contactName  String            @map("contact_name")
  practiceName String            @map("practice_name")
  email        String
  emailDomain  String            @map("email_domain")
  token        String            @unique // verify-link param + ongoing access secret
  status       SetterAuditStatus @default(CREATED)
  emailVerified Boolean          @default(false) @map("email_verified")
  approved     Boolean           @default(false)
  isFree       Boolean           @default(true) @map("is_free")
  caseValueUsd Int?              @map("case_value_usd")
  monthlyLeads Int?              @map("monthly_leads")
  overallScore Decimal?          @map("overall_score") @db.Decimal(2, 1)
  bookedCount  Int?              @map("booked_count")
  topLeakSkills Json?            @map("top_leak_skills")
  estimatedRecovery Json?        @map("estimated_recovery")
  stripePaymentIntent String?    @map("stripe_payment_intent")
  baselineAt   DateTime?         @map("baseline_at")
  lastInviteAt DateTime?         @map("last_invite_at") // bimonthly prospect re-engagement
  createdAt    DateTime          @default(now()) @map("created_at")

  office   Office    @relation(fields: [officeId], references: [id])
  sessions Session[]

  @@index([emailDomain])
  @@map("setter_audit")
}

model Evaluation {
  id                      String   @id @default(uuid())
  sessionId               String   @unique @map("session_id")
  overallScore            Decimal? @map("overall_score") @db.Decimal(2, 1)
  narrative               String?
  wins                    Json?    // string[]
  misses                  Json?    // string[]
  replacementPhrases      Json?    @map("replacement_phrases") // [{from,to}]
  personaCoaching         String?  @map("persona_coaching")
  recommendedNextScenario String?  @map("recommended_next_scenario")
  rawPayload              Json?    @map("raw_payload")
  booked                  Boolean? // did the lead actually schedule a consult on this call (independent of score)
  scoredAt                DateTime? @map("scored_at") // null = transcript captured but not yet scored
  createdAt               DateTime @default(now()) @map("created_at")

  session Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skills  SkillScore[]

  @@map("evaluation")
}

model SkillScore {
  evaluationId String    @map("evaluation_id")
  skillKey     String    @map("skill_key")
  tier         SkillTier
  score        Decimal   @db.Decimal(2, 1)
  reasoning    String?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@id([evaluationId, skillKey])
  @@map("skill_score")
}

// ---------- coaching ----------

model SetterMemory {
  setterId        String     @id @map("setter_id")
  summary         String?
  difficultyFloor Difficulty @default(ADAPTIVE) @map("difficulty_floor")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  setter User @relation(fields: [setterId], references: [id], onDelete: Cascade)

  @@map("setter_memory")
}

// Cached Setty "next move" recommendation per subject (a setter, an office, or a
// group). Generated on demand, refreshed periodically — shown inline on the
// dashboards and reused in the weekly digests.
model CoachInsight {
  id          String   @id @default(uuid())
  scope       String // "SETTER" | "OFFICE" | "GROUP"
  subjectId   String   @map("subject_id") // userId | officeId | organizationId
  headline    String
  body        String
  model       String?
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([scope, subjectId])
  @@map("coach_insight")
}

model Training {
  id             String         @id @default(uuid())
  title          String
  description    String?
  type           TrainingType
  length         Int            @default(0) // minutes (video) / pages (workbook)
  targetSkillKey String?        @map("target_skill_key")
  status         TrainingStatus @default(DRAFT)
  assetRef       String?        @map("asset_ref")

  recommendations Recommendation[]

  @@map("training")
}

model Recommendation {
  id         String               @id @default(uuid())
  setterId   String               @map("setter_id")
  sessionId  String?              @map("session_id")
  trainingId String               @map("training_id")
  skillKey   String               @map("skill_key")
  reason     String // stored: "objection-handling scored 2/5 on the last two sessions"
  status     RecommendationStatus @default(ACTIVE)
  createdAt  DateTime             @default(now()) @map("created_at")

  setter   User     @relation(fields: [setterId], references: [id], onDelete: Cascade)
  training Training @relation(fields: [trainingId], references: [id])

  @@index([setterId])
  @@map("recommendation")
}

// ---------- billing & usage ----------

model Subscription {
  id                   String             @id @default(uuid())
  officeId             String             @unique @map("office_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  seats                Int                @default(1) // setter seats (drives the pooled allowance)
  planTier             PlanTier           @default(TEAM) @map("plan_tier")
  isFounder            Boolean            @default(false) @map("is_founder")
  cadence              Cadence            @default(QUARTERLY)
  pricePerSeat         Decimal            @default(59.99) @map("price_per_seat") @db.Decimal(6, 2) // legacy
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?          @map("current_period_end")

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@map("subscription")
}


model ConversationBundle {
  id                  String    @id @default(uuid())
  officeId            String    @map("office_id")
  hours               Int
  minutesPurchased    Int       @map("minutes_purchased")
  minutesRemaining    Int       @map("minutes_remaining")
  amountCents         Int?      @map("amount_cents") // what the customer paid (cash revenue)
  stripePaymentIntent String?   @map("stripe_payment_intent")
  purchasedAt         DateTime  @default(now()) @map("purchased_at")
  expiresAt           DateTime? @map("expires_at")

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId])
  @@map("conversation_bundle")
}

// ---------- leaderboards (materialized) ----------

model LeaderboardEntry {
  id             String            @id @default(uuid())
  scope          LeaderboardScope
  officeId       String?           @map("office_id")
  organizationId String?           @map("organization_id")
  subjectType    SubjectType       @map("subject_type")
  subjectId      String            @map("subject_id")
  serviceType    ServiceKey        @map("service_type")
  metric         LeaderboardMetric @default(AVG_SCORE)
  value          Float
  movement       Int               @default(0)
  rank           Int               @default(0)
  periodKey      String            @map("period_key")
  computedAt     DateTime          @default(now()) @map("computed_at")

  @@index([scope, serviceType, periodKey])
  @@map("leaderboard_entry")
}

// Audit trail for sensitive internal-admin actions (comps, access changes,
// impersonation, user changes). Append-only.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String // e.g. "impersonate.start", "minutes.grant", "access.pause", "user.role"
  targetType String?  @map("target_type") // "office" | "user" | "account"
  targetId   String?  @map("target_id")
  summary    String
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_log")
}

// ---------- goals & incentives ----------

enum GoalCreatorScope {
  OFFICE
  GROUP
}

enum GoalTargetType {
  SETTER
  TEAM
}

enum GoalMetric {
  OVERALL_SCORE
  SKILL_SCORE
  SET_RATE
  SHOW_RATE
  CONSULTS
  CASES
  PRODUCTION
  REPS
  PRACTICE_HOURS
  STREAK_WEEKS
  LEADERBOARD_RANK
  PERSONAL_BEST
  MANUAL
}
enum GoalComparator {
  REACH
  IMPROVE_BY
  MAINTAIN
  RANK_TOP
}

enum GoalWindow {
  THIS_MONTH
  LAST_30D
  CUSTOM
  ONGOING
}

enum GoalRecurrence {
  NONE
  MONTHLY
}

enum GoalRewardType {
  GIFT_CARD
  CUSTOM
}

enum GoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RewardStatus {
  NONE
  PENDING
  APPROVED
  SENT
  FAILED
  DECLINED
}

// A goal an office or group sets for a setter or a whole team/practice. Tied to
// the existing analytics; achievement is auto-detected, payout admin-approved.
model Goal {
  id                String           @id @default(uuid())
  creatorScope      GoalCreatorScope @map("creator_scope")
  officeId          String?          @map("office_id") // office goals, or the practice a group goal targets
  organizationId    String?          @map("organization_id") // group goals
  createdById       String           @map("created_by_id")
  title             String
  description       String?
  targetType        GoalTargetType   @map("target_type")
  metric            GoalMetric
  skillKey          String?          @map("skill_key") // when metric = SKILL_SCORE
  comparator        GoalComparator   @default(REACH)
  targetValue       Float            @map("target_value")
  window            GoalWindow       @default(THIS_MONTH)
  startDate         DateTime?        @map("start_date")
  endDate           DateTime?        @map("end_date")
  recurrence        GoalRecurrence   @default(NONE)
  seriesId          String?          @map("series_id") // links monthly-recurring instances
  periodKey         String?          @map("period_key") // "2026-06" for a recurring instance
  minQualifyingReps Int              @default(5) @map("min_qualifying_reps")
  rewardType        GoalRewardType   @default(GIFT_CARD) @map("reward_type")
  rewardAmountCents Int?             @map("reward_amount_cents")
  rewardLabel       String?          @map("reward_label")
  funderScope       GoalCreatorScope @map("funder_scope")
  includeManager    Boolean          @default(false) @map("include_manager")
  status            GoalStatus       @default(DRAFT)
  teamValue         Float?           @map("team_value") // aggregate result for TEAM goals
  teamAchieved      Boolean          @default(false) @map("team_achieved")
  achievedAt        DateTime?        @map("achieved_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  office       Office?           @relation(fields: [officeId], references: [id])
  organization Organization?     @relation(fields: [organizationId], references: [id])
  participants GoalParticipant[]

  @@index([officeId, status])
  @@index([organizationId, status])
  @@index([seriesId])
  @@map("goal")
}

// Per-person assignment of a goal: progress + reward/payout status.
model GoalParticipant {
  id                String       @id @default(uuid())
  goalId            String       @map("goal_id")
  setterId          String       @map("setter_id")
  baselineValue     Float?       @map("baseline_value") // captured at activation (IMPROVE_BY)
  currentValue      Float        @default(0) @map("current_value")
  progressPct       Float        @default(0) @map("progress_pct")
  qualified         Boolean      @default(false) // met participation threshold
  achieved          Boolean      @default(false)
  achievedAt        DateTime?    @map("achieved_at")
  rewardStatus      RewardStatus @default(NONE) @map("reward_status")
  rewardAmountCents Int?         @map("reward_amount_cents")
  approvedById      String?      @map("approved_by_id")
  sentAt            DateTime?    @map("sent_at")
  providerRef       String?      @map("provider_ref")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  setter User @relation(fields: [setterId], references: [id])

  @@unique([goalId, setterId])
  @@index([setterId])
  @@map("goal_participant")
}
