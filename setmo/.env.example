# ============================================================
# SetMo — environment configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit secrets.
# ============================================================

# ---- Database (Supabase Postgres, accessed via Prisma) ----
# Runtime: the pooled connection (Transaction mode, port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: the direct connection (Session mode, port 5432). Used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase (auth + storage) ----
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-only; never exposed to the browser

# ---- ElevenLabs (conversational voice agents) ----
ELEVENLABS_API_KEY="<api-key>"
ELEVENLABS_WEBHOOK_SECRET="<post-call-webhook-hmac-secret>"
# Per-service agent ids. v1 ships the implant/full-arch/denture agent only.
ELEVENLABS_AGENT_IMPLANT="<agent-id>"
# Voice coach agent (separate; accepts system-prompt + first-message overrides).
ELEVENLABS_COACH_AGENT_ID="<agent-id>"
# NEXT_PUBLIC variant lets the browser SDK connect with the signed config.
NEXT_PUBLIC_ELEVENLABS_AGENT_IMPLANT="<agent-id>"

# ---- Stripe (seat subscriptions + conversation bundles) ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price ids (created in Stripe). Seat subscription, monthly/quarterly.
STRIPE_PRICE_SEAT_MONTHLY="price_..."
STRIPE_PRICE_SEAT_QUARTERLY="price_..."
# One-time conversation bundle prices.
STRIPE_PRICE_BUNDLE_5H="price_..."
STRIPE_PRICE_BUNDLE_10H="price_..."
STRIPE_PRICE_BUNDLE_20H="price_..."

# ---- Resend (transactional email: setter invites) ----
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="SetMo <noreply@yourdomain.com>"

# ---- Anthropic (Claude) — SetMo's transcript scorer ----
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override for scoring (defaults to claude-opus-4-8)
# SETMO_SCORER_MODEL="claude-opus-4-8"

# ---- Trigger.dev (background jobs) ----
TRIGGER_SECRET_KEY="tr_..."
TRIGGER_PROJECT_ID="proj_..."

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
