{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/goals",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/ghl-retention",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/nudges",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/rescore",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/partner-payouts",
      "schedule": "0 9 1,15 * *"
    },
    {
      "path": "/api/cron/leaderboards",
      "schedule": "*/15 * * * *"
    }
  ]
}
